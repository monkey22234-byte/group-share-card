rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fellowship rooms and subcollections (actions, reactions, answers)
    match /rooms/{roomId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Shared topics
    match /topics/{topicId} {
      allow read, write: if true;
    }

    // Catch-all for application documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
